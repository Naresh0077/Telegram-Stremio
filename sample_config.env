# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# ---- File Explorer (/explorer) — all optional ----
# EXPLORER_LINK_TTL=21600        # lifetime (seconds) of signed stream / VLC links
# EXPLORER_ALLOW_TRANSCODE=true  # allow H.264 re-encode when remux isn't enough (CPU heavy; set false on small VMs)
# EXPLORER_MAX_FFMPEG=2          # max simultaneous remux/transcode jobs
# EXPLORER_MAX_HEIGHT=1080       # transcode output height cap
# EXPLORER_AUTO_SYNC=false       # run an incremental index ~60s after every start
