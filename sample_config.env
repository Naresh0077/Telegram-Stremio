# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# ---- File Explorer (/explorer) — optional ----
# EXPLORER_AUTO_SYNC=false       # run an incremental index ~60s after every start
# EXPLORER_THUMBS=true            # first-frame thumbnails for MKVs: only active if you also add the 'av' package (see EXPLORER.md)
# EXPLORER_THUMB_MAX_MB=450       # memory cap of the thumbnail helper process
# EXPLORER_THUMB_MIN_FREE_MB=200  # skip thumbnail work when less RAM than this is free
# EXPLORER_THUMB_DIR=/app/thumbs  # keep thumbnails across restarts (mount a volume here)
