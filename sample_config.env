# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# ---- File Explorer (/explorer) — optional ----
# EXPLORER_AUTO_SYNC=false       # run an incremental index ~60s after every start
# EXPLORER_THUMBS=true            # make thumbnails from the video itself when Telegram has none (needs the 'av' package)
# EXPLORER_THUMB_JOBS=3           # videos processed at the same time
# EXPLORER_THUMB_CACHE_MB=300     # size cap of the thumbnail cache
# EXPLORER_THUMB_DIR=/app/thumbs  # keep thumbnails across restarts (mount a volume here)
